# ==============================================================================
# DocuStream Web - Root .gitignore
# ==============================================================================

# Environment files & Secrets
.env
.env*.local
.env.production
.env.staging
.env.development
.env.test
!.env.example
!.env.*.example

# AWS SAM & Infrastructure Artifacts
.aws-sam/
samconfig.toml
*.template

# AWS Credentials & Keys
.aws/
credentials
*.pem
*.key

# Python Virtual Environments & Bytecode
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node & Package Managers
node_modules/
.pnp
.pnp.js

# Next.js Build Artifacts
.next/
out/
build/
dist/

# Vercel Deployment Artifacts
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
