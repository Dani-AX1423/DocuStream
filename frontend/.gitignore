# ==============================================================================
# DocuStream Frontend - Next.js .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Production & Build outputs
/.next/
/out/
/build/
/dist/

# Vercel Artifacts
.vercel

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Environment variables & Local configuration
.env
.env*.local
.env.production
.env.staging
.env.development
.env.test
!.env.example

# TypeScript
*.tsbuildinfo

# OS & Editor files
.DS_Store
*.pem
.idea/
.vscode/
