# ==============================================================================
# DocuStream Web - Environment Variables Template
# Copy this file to .env.local and replace with your AWS API Gateway endpoint
# ==============================================================================

# AWS API Gateway Base URL (Generated by deploy_backend.sh or AWS CloudFormation)
NEXT_PUBLIC_API_GATEWAY_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/prod

# Default Demo User Identifier for testing storage quota and documents
NEXT_PUBLIC_DEFAULT_USER_ID=user-demo-1
