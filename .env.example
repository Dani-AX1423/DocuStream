# ==============================================================================
# DocuStream Web - Root Environment Variables Template
# ==============================================================================

# AWS Configuration (Used by deploy_backend.sh and AWS SAM)
AWS_REGION=us-east-1
STACK_NAME=docustream-web-stack
ENVIRONMENT=prod

# Frontend AWS API Gateway Endpoint
NEXT_PUBLIC_API_GATEWAY_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_DEFAULT_USER_ID=user-demo-1
